{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "src/web/**/*.ts",
    "scripts/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/seguridad/**/*.ts",
    "tests/scripts/**/*.ts",
