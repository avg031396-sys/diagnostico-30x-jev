{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diagnostico-30x-jev",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-12",
  // Sin telemetría ni preguntas interactivas de wrangler (también va WRANGLER_SEND_METRICS=false en Bootstrap).
  "send_metrics": false,
  // Vite construye ./dist; el Worker solo corre primero en /api/* y /r/*.
  // not_found_handling "404-page" funciona con wrangler 4.151.1; el paso 1 lo ejercita con un 404 real.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/r/*"]
  },
  // database_id local fijo y válido para --local. En el despliegue se reemplaza por el id
  // que imprime `npx wrangler d1 create diagnostico-30x-jev` (blueprint §20.1, lista de lanzamiento).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diagnostico-30x-jev",
      "database_id": "9c7ba82f-99ff-4213-b5f5-4167abc5b3e9",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "LIMITE_DIAGNOSTICO",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Secretos (nunca aquí): COMPOSIO_API_KEY, COMPOSIO_OPENROUTER_ACCOUNT_ID,
  // COMPOSIO_JEV_ACCOUNT_ID (opcional), QA_TOKEN. Local: .dev.vars. Producción: wrangler secret put.
  "vars": {
    "JEV_MODE": "openrouter",
    "JEV_MODEL": "typesafe/jev-1.14",
    "LIMITE_ACTIVO": "1"
  },
  "observability": {
    "enabled": true
  }
}
